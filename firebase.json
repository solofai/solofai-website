{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "trailingSlash": true,
    "redirects": [
      { "source": "/academic", "destination": "/about/", "type": 301 },
      { "source": "/engineering", "destination": "/about/", "type": 301 },
      { "source": "/projects", "destination": "/work/", "type": 301 },
      { "source": "/contact", "destination": "/#contact", "type": 301 }
    ],
    "headers": [
      {
        "source": "/_astro/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
      }
    ]
  }
}
