---
/**
 * One row of a list: supporting metadata in the left margin, content on the
 * right. Collapses to a single column on narrow screens. Used by every list
 * on the site so they share one alignment grid.
 */
interface Props {
  as?: 'li' | 'article' | 'div';
}
const { as: Tag = 'li' } = Astro.props;
---

<Tag class="entry">
  <div class="entry__aside meta"><slot name="aside" /></div>
  <div class="entry__body stack"><slot /></div>
</Tag>

<style>
  .entry {
    display: grid;
    gap: var(--space-1) var(--space-4);
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-rule);
  }
  .entry__body {
    --flow: var(--space-2);
    max-width: var(--measure);
  }
  @media (min-width: 52rem) {
    .entry {
      grid-template-columns: var(--margin-col) minmax(0, 1fr);
    }
    .entry__aside {
      padding-top: 0.3em; /* align sans meta with serif first line */
    }
  }
</style>
