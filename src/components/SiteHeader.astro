---
import { NAV, SITE } from '@/config';
import { getPosts } from '@/lib/content';

// Hide nav items whose backing collection has nothing published yet,
// so visitors never land on an empty page.
const hasPosts = (await getPosts()).length > 0;
const items = NAV.filter((item) => item.requires !== 'writing' || hasPosts);

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="wrap site-header">
  <a class="site-name" href="/">{SITE.name}</a>
  <nav aria-label="Main">
    <ul>
      {
        items.map(({ label, href }) => (
          <li>
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-rule);
    font-family: var(--font-sans);
  }
  .site-name {
    font-weight: 700;
    font-size: var(--step-0);
    text-decoration: none;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    list-style: none;
    padding: 0;
  }
  nav a {
    font-size: var(--step--1);
    text-decoration: none;
    color: var(--color-ink-muted);
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-ink);
    text-decoration-line: underline;
  }
</style>
