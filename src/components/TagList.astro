---
interface Props {
  tags: readonly string[];
}
const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tags meta" aria-label="Topics">
      {tags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
  )
}

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    list-style: none;
    padding: 0;
  }
</style>
