---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import TagList from '@/components/TagList.astro';
import { getWork } from '@/lib/content';
import { WORK_STATUS_LABEL } from '@/lib/format';

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
---

<BaseLayout title={data.title} description={data.summary}>
  <article>
    <PageHeader title={data.title}>
      <span slot="meta">{WORK_STATUS_LABEL[data.status]}</span>
      {data.summary}
    </PageHeader>
    <div class="prose stack">
      <Content />
      {
        data.links.length > 0 && (
          <ul class="links">
            {data.links.map(({ label, href }) => (
              <li>
                <a href={href} rel="noopener">
                  {label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <TagList tags={data.tags} />
    </div>
    <p class="back meta"><a href="/work/">All work</a></p>
  </article>
</BaseLayout>

<style>
  .links {
    list-style: none;
    padding: 0;
    font-family: var(--font-sans);
    font-weight: 600;
  }
  .back {
    margin-block-start: var(--space-6);
  }
</style>
