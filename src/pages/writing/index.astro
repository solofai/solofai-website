---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import PostList from '@/components/PostList.astro';
import { getPosts } from '@/lib/content';

const posts = await getPosts();
---

<BaseLayout title="Writing" description="Notes and essays by Lori Pickering." noindex={posts.length === 0}>
  <PageHeader title="Writing">Notes on building and verifying AI systems.</PageHeader>
  {posts.length > 0 ? <PostList items={posts} /> : <p>Nothing published yet.</p>}
</BaseLayout>
